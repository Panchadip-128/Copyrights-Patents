    "data_access_statement_mandatory": true
  },
  "rules": [
    {
      "rule_id": "UKRI-2024-01",
      "clause": "immediate_oa",
      "description": "Immediate open access via publisher or repository at publication time",
      "mandatory": true
    },
    {
      "rule_id": "UKRI-2024-02",
      "clause": "cc_by_license",
      "description": "CC-BY 4.0 license applied to Version of Record or Author Accepted Manuscript",
      "mandatory": true
    },
    {
      "rule_id": "UKRI-2024-03",
      "clause": "data_access_statement",
      "description": "Data Access Statement included explaining how underlying data can be accessed",
      "mandatory": true
    }
  ]
