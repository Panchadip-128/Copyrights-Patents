  "policy_version": "v2024.2",
  "effective_date": "2024-04-01",
  "mandate_reference": "UKRI Open Access Policy for Peer-Reviewed Research Articles and Monographs",
  "digest": "sha256-99887766554433221100ffeeddccbbaa99887766554433221100ffeeddccbbaa",
  "requirements": {
    "immediate_open_access": true,
